# =============================================================================
# sector2-infra — environment variables reference
#
# This file lists ALL variables needed across all services.
# Copy to .env (gitignored) for local dev, OR set in Railway dashboard.
#
# Each service also documents its required variables in:
#   services/<name>/README.md
#
# === sector2-superset ===
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sector2.local
ADMIN_PASSWORD=changeme-strong-password
SECRET_KEY=changeme-32-char-random-string
SUPERSET_SECRET_KEY=changeme-32-char-random-string
# Use Railway reference: ${{ Postgres.DATABASE_URL }}
SQLALCHEMY_DATABASE_URI=postgresql://user:pass@host:5432/dbname
# Optional
REDIS_URL=
MAPBOX_API_KEY=

# === sector2-trino ===
# R2 Data Catalog (Cloudflare R2 + Iceberg REST)
R2_ICEBERG_REST_URI=https://catalog.cloudflarestorage.com/<account-id>/<bucket-name>
R2_ICEBERG_WAREHOUSE=<account-id>_<bucket-name>
R2_CATALOG_TOKEN=cfat_xxxxxxxxxxxx
# R2 S3 filesystem (for Iceberg data files)
R2_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# ClickHouse JDBC catalog
CLICKHOUSE_HOST=clickhouse.railway.internal
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Reference vars (auto-provided by Railway) ===
# These are set automatically when referenced services exist:
#   ${{ Postgres.DATABASE_URL }}     - PostgreSQL connection URL
#   ${{ ClickHouse.DATABASE_URL }}   - ClickHouse connection URL (if service exists)
#   ${{ Redis.REDIS_URL }}           - Redis connection URL (if service exists)
#   ${{ <service-name>.RAILWAY_PRIVATE_DOMAIN }}  - internal DNS