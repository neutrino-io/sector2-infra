# Trino worker node config (paired with the coordinator service)
coordinator=false
node-scheduler.include-coordinator=false
http-server.http.port=8080
# Connect to the coordinator service via Railway's internal DNS.
# In single-tenant Railway projects, services can reach each other
# at <service-name>.railway.internal.
discovery.uri=http://sector2-trino.railway.internal:8080
# Advertise the worker's own Railway private domain as the URL
# the coordinator should call back to. Required so the coordinator
# resolves <service>.railway.internal correctly (instead of using
# the worker's internal IP which may be unreachable from the
# coordinator's network namespace).
http-server.http.host=sector2-trino-worker.railway.internal
node.id=trino-worker-1
node.environment=production

# Railway's edge proxy sets X-Forwarded-For - Trino 483 rejects by default.
# Enable processing of forwarded headers from the trusted Railway proxy.
http-server.process-forwarded=true

# Items #3 (Trino QUEUED investigation) — 2026-10-03:
# See config.properties.template.coordinator for the rationale. Workers
# inherit the same timeouts so a stuck query times out on both ends.
query.max-run-time=10m
query.min-expire-age=10m
