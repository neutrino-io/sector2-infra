# sector2-infra env var template
# Copy to .env (gitignored) and fill in real values.
# DO NOT commit .env to git.

# ============================================================
# Superset admin
# ============================================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sector2.local
ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# ============================================================
# Superset secret keys (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
# ============================================================
SECRET_KEY=CHANGE_ME_GENERATE_NEW_KEY
SUPERSET_SECRET_KEY=CHANGE_ME_GENERATE_NEW_KEY

# ============================================================
# Database URIs
# ============================================================
# Format: postgresql://user:password@host:port/database
# From Railway PostgreSQL plugin → Variables → POSTGRES_URL
SQLALCHEMY_DATABASE_URI=postgresql://user:password@host:port/database

# Optional: Redis for caching + rate limiting
# Format: redis://default:password@host:port
REDIS_URL=redis://default:password@host:port

# ============================================================
# Cloudflare R2 Data Catalog (Phase 1 Iceberg PoC)
# ============================================================
# Get from: Cloudflare Dashboard → R2 → API tokens → Create (Admin Read & Write template)
R2_CATALOG_TOKEN=cfat_CHANGEME
R2_ACCESS_KEY=CHANGEME
R2_SECRET_KEY=CHANGEME

# ============================================================
# ClickHouse (legacy voter roll)
# ============================================================
# Host: clickhouse.railway.internal (private network)
# Port: 9000 (native protocol) or 8123 (HTTP)
# User/Password: from Railway ClickHouse plugin → Variables
CLICKHOUSE_HOST=clickhouse.railway.internal
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGEME

# ============================================================
# Constants (not secrets — account-specific deployment values)
# ============================================================
# R2 catalog URI (Cloudflare account ID + bucket)
R2_ICEBERG_REST_URI=https://catalog.cloudflarestorage.com/203a605533f37eb35da80dcf03a7bed6/gyhc40sdz8-ivj8v3841x-bronze-storage

# R2 S3 endpoint (for native file access via fs.native-s3.enabled)
R2_S3_ENDPOINT=https://203a605533f37eb35da80dcf03a7bed6.r2.cloudflarestorage.com